{
  "expo": {
    "name": "EKALAN",
    "slug": "ekalan-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_mobile.png",
    "scheme": "ekalanmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
       "bundleIdentifier": "com.ekalan.education",
      "buildNumber": "1",
      "icon": "./assets/images/logo_mobile.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logo_mobile.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "package": "com.ekalan.education"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_mobile.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00266F",
          "dark": {
            "backgroundColor": "#00266F"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3fc20f44-2924-4a6e-aab1-ac0950211fe5"
      }
    }
  }
}
